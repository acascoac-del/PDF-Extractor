# =========================================================
#  PDF Extractor — variables de entorno
#  Copiar a .env y ajustar los valores
# =========================================================

# --- App ---
APP_NAME=PDF Extractor
ENVIRONMENT=development            # development | production
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 dias
TIMEZONE=America/Argentina/Buenos_Aires

# --- Base de datos ---
# SQLite (default). Para Postgres: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./storage/app.db

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- LLM (cliente OpenAI-compatible) ---
# OPENAI_BASE_URL apunta al proveedor:
#   OpenAI:    https://api.openai.com/v1
#   OpenRouter:https://openrouter.ai/api/v1
#   Ollama:    http://localhost:11434/v1
#   Groq:      https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-tu-clave-aqui
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60

# --- OCR ---
TESSERACT_CMD=                     # Dejar vacio para autodeteccion (Linux/Docker). En Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=spa+eng              # Lenguajes Tesseract separados por +
OCR_DPI=300

# --- Almacenamiento ---
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed
EXPORTS_DIR=./storage/exports
MAX_UPLOAD_MB=30

# --- Seguridad / retencion ---
AUTO_DELETE_DAYS=30                # Dias tras los que se borran documentos procesados (0 = nunca)
CLEANUP_CRON_HOUR=3                # Hora (0-23) para correr el cleanup diario

# --- Cliente admin inicial ---
# Si INITIAL_ADMIN_EMAIL/USERNAME/_PASSWORD estan seteados, se crea al arranque
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# --- Stripe (pagos / suscripciones) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
